{
  "version": 1,
  "topo": "fiti.json",
  "datapath": "bmv2",
  "isolation": "vlan",
  "p4runtime": {
    "thrift_base": null,
    "grpc_base": null
  },
  "control": {
    "socket": "/tmp/fiti.sock"
  },
  "p4": {
    "json": "build/fiti_slice.json",
    "thrift_base": null,
    "log_level": "info",
    "log_dir": null,
    "pcap": false,
    "pcap_dir": "pcap",
    "spanning_root": null
  },
